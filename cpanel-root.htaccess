<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Proxy WebSocket connections directly to Laravel Reverb
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^app/(.*) ws://127.0.0.1:8080/app/$1 [P,L]
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^app$ ws://127.0.0.1:8080/app [P,L]

    # 2. Rewrite normal HTTP requests to the 7series public directory
    RewriteCond %{REQUEST_URI} !^/7series/public/
    RewriteRule ^(.*)$ /7series/public/$1 [L]
</IfModule>
